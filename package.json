{
  "name": "@ranui/preview",
  "version": "0.2.0",
  "description": "Browser-native PDF and Office file preview with configurable self-hosted rendering",
  "main": "dist/umd/index.umd.cjs",
  "module": "dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranuts/fileview.git"
  },
  "author": "chaxus",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "node ./scripts/build.mjs",
    "build:es": "vite build -c ./build/config.es.ts",
    "build:umd": "vite build -c ./build/config.umd.ts",
    "test": "playwright test",
    "test:report": "playwright show-report",
    "test:ui": "playwright test --ui",
    "test:update": "playwright test --update-snapshots",
    "tsc": "tsc --noEmit",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "test:package": "node ./scripts/verify-package.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/umd/index.d.cts",
        "default": "./dist/umd/index.umd.cjs"
      }
    },
    "./preview": {
      "import": {
        "types": "./dist/components/preview/index.d.ts",
        "default": "./dist/preview.js"
      },
      "require": {
        "types": "./dist/umd/index.d.cts",
        "default": "./dist/umd/index.umd.cjs"
      }
    },
    "./type": {
      "types": "./dist/components/preview/types.d.ts",
      "default": "./dist/type.js"
    },
    "./typings": {
      "types": "./dist/typings.d.ts",
      "default": "./dist/typings.js"
    },
    "./dist/*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*"
    },
    "./manual": {
      "types": "./dist/manual.d.ts",
      "import": "./dist/manual.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [],
  "license": "AGPL-3.0",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.2.17",
    "less": "4.9.1",
    "prettier": "3.9.10",
    "terser": "5.51.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "@types/node": "26.6.5",
    "pdfjs-dist": "6.4.299",
    "publint": "0.3.25"
  },
  "dependencies": {
    "ranui": "0.5.0",
    "ranuts": "0.5.0"
  },
  "packageManager": "pnpm@11.6.0"
}
